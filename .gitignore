# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
functions/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# next-pwa / Workbox (gerados em `npm run build` em produção)
/public/sw.js
/public/workbox-*.js
/public/fallback-*.js

# production
/build

# referências de defesa (PDFs de clientes — só uso local)
/docs/referencias/*.pdf

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.genkit/*
.env*
!.env.example

# Conta de serviço Firebase (nunca versionar)
config/firebase-service-account.json

# URL HTTPS da app empacotada no Capacitor (não versionar)
/capacitor/deployment-url

# firebase
firebase-debug.log
firestore-debug.log
.firebase/logs/

# branding local (imagens salvas no notebook)
/public/branding

# templates carregados (DOCX base para estudos)
/public/templates

# Cursor / IDE
.idx/
.modified

# Temporários locais (instaladores, cache, etc.)
.tmp/

# Python (venv local — não versionar)
venv/
.venv/
**/__pycache__/

# Cache Firebase CLI (evita ruído em git status)
.firebase/

# Node.js portátil (usado para rodar sem instalação global)
.tools/
node-v*-win-x64/
node-v*-win-x64.zip