# Copie para .env.local e preencha (não commitar .env.local).

# --- Firebase Admin (rotas API: liberar e-mail, mapas, etc.) ---
# Opção A: caminho absoluto para o JSON da conta de serviço (recomendado no Windows)
# GOOGLE_APPLICATION_CREDENTIALS=E:\A\config\firebase-service-account.json

# Opção B: JSON completo numa linha (comum em Vercel / App Hosting secrets)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Opção C: coloque o JSON em config/firebase-service-account.json (gitignored)

# --- Push no celular (FCM / PWA) — Firebase Console → Cloud Messaging → certificados Web Push → chave pública VAPID ---
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- IA: leve (Gemini) + pesado (DeepSeek) — ver docs/IA-ROTEAMENTO.md ---
# GOOGLE_GENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_LIGHT_MODEL=gemini-2.5-flash
# GENKIT_GOOGLE_MODEL=gemini-2.5-flash
# DEEPSEEK_HEAVY_MODEL=deepseek-v4-flash
# GENKIT_PROVIDER=google
# IA_LIGHT_MAX_CHARS=6000
# IA_ROUTER=on

# --- Opcional: importação de termos de referência (dev local; produção: App Hosting + docs/APP-HOSTING-VARIAVEIS.md) ---
# ENABLE_AI_LOCAL_IMPORT=true
# AI_REFERENCE_FILES_PATH=
# NEXT_PUBLIC_AI_REFERENCE_FILES_PATH=
