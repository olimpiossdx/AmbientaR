# Copie para .env.local e preencha (não commitar .env.local).

# --- Firebase Admin (rotas API: liberar e-mail, mapas, etc.) ---
# Opção A: caminho absoluto para o JSON da conta de serviço (recomendado no Windows)
# GOOGLE_APPLICATION_CREDENTIALS=E:\A\config\firebase-service-account.json

# Opção B: JSON completo numa linha (comum em Vercel / App Hosting secrets)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Opção C: coloque o JSON em config/firebase-service-account.json (gitignored)

# --- Push no celular (FCM / PWA) — Firebase Console → Cloud Messaging → certificados Web Push → chave pública VAPID ---
# Também ative "Firebase Cloud Messaging API" no Google Cloud (projeto Firebase). Sem VAPID, push é ignorado (sem erro na consola).
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# --- IA: leve (Gemini) + pesado (DeepSeek) — ver docs/IA-ROTEAMENTO.md ---
# Não use OPENAI_API_KEY: a app não chama OpenAI nem debita ChatGPT Business/Codex.
# GOOGLE_GENAI_API_KEY=
# DEEPSEEK_API_KEY=
# GEMINI_LIGHT_MODEL=gemini-2.5-flash
# GENKIT_GOOGLE_MODEL=gemini-2.5-flash
# DEEPSEEK_HEAVY_MODEL=deepseek-v4-flash
# IA_LIGHT_MAX_CHARS=6000
# IA_ROUTER=on
# Complemento geo Etapa 2 com Gemini: 0 ou omitido = gratuito ilimitado (padrão AmbientaR)
# Só defina um número > 0 se quiser teto administrativo excepcional
# GEO_IA_GEMINI_MONTHLY_LIMIT=0

# --- Opcional: importação de termos de referência (dev local; produção: App Hosting + docs/APP-HOSTING-VARIAVEIS.md) ---
# ENABLE_AI_LOCAL_IMPORT=true
# AI_REFERENCE_FILES_PATH=
# NEXT_PUBLIC_AI_REFERENCE_FILES_PATH=

# --- OneDrive / Microsoft Graph (sync catálogo; ficheiros ficam no OneDrive) ---
# ONEDRIVE_SYNC_ENABLED=true
# MICROSOFT_GRAPH_TENANT_ID=
# MICROSOFT_GRAPH_CLIENT_ID=
# MICROSOFT_GRAPH_CLIENT_SECRET=
# ONEDRIVE_DEFAULT_DRIVE_ID=
# ONEDRIVE_DRIVE_NAME_HINT=Pimenta
# ONEDRIVE_CLIENT_READONLY_ENABLED=false
# ONEDRIVE_AUTONOMO_WRITE_ENABLED=false

# --- OneDrive pessoal (Microsoft 365 Family / @outlook): OAuth delegado ---
# ONEDRIVE_GRAPH_AUTH_MODE=delegated
# ONEDRIVE_GRAPH_AUTHORITY=consumers
# ONEDRIVE_GRAPH_REDIRECT_URI=http://localhost:9002/api/onedrive-consumer/auth/callback
# ONEDRIVE_GRAPH_SCOPES=openid profile offline_access User.Read Files.Read
# NEXT_PUBLIC_SITE_URL=http://localhost:9002

# --- Biblioteca IA na nuvem (cloud-rag; separado do import local) ---
# ONEDRIVE_AUTOFILL_MAX_FILES=8
# Piloto autofill sem cliente no Firestore (opcional):
# ONEDRIVE_PILOT_CPF=95704640649
# ONEDRIVE_PILOT_FOLDER_PATH=Pimenta Ltda/CLIENTES/Luciano Rodrigues Branquinho
# ONEDRIVE_RAG_ENABLED=true
# ONEDRIVE_RAG_SEARCH_ENABLED=true
# ONEDRIVE_LIBRARY_ROOT_PATH=Pimenta Ltda
# ONEDRIVE_RAG_MAX_FILE_MB=25
# ONEDRIVE_RAG_MAX_FILES_PER_JOB=50
# ONEDRIVE_RAG_MAX_SYNC_PAGES=50
# ONEDRIVE_RAG_CHUNK_CHARS=3500
# NEXT_PUBLIC_ONEDRIVE_RAG_SEARCH_ENABLED=true

# --- MCP + RAG enterprise (Fase C — hub Configurações) ---
# ALMG_OPEN_DATA_BASE_URL=https://dadosabertos.almg.gov.br
# ALMG_PORTAL_SCRAPER_FALLBACK=false
# LEGISLATION_PIPELINE_ENABLED=false
# LEGISLATION_PIPELINE_URL=http://localhost:8092
# LEGISLATION_PIPELINE_SECRET=dev-legislation-secret
# DATABASE_URL=postgresql://ambientar:ambientar@localhost:5433/legislation

# --- Google Maps (Telemetria / mapas com @react-google-maps/api) ---
# Opcional: chave dedicada. Se omitida, usa firebaseConfig.apiKey (Maps JavaScript API no mesmo projeto GCP).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Obtenha o ID em Google AdSense → Conta → Configurações da conta (formato ca-pub-XXXXXXXX)
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
# Slots de unidade de anúncio (opcional; sem slot, exibe placeholder só em dev)
# NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=
# NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# --- Fiscal Ambiental Digital (INPE/CBERS — Fase 0+) ---
# FAD_ENABLED=true
# FAD_STANDALONE_MODE=true
# FAD_ENABLE_SIG_CROSSCHECK=false  # PRODES, MapBiomas, embargos IBAMA no FAD
# FAD_MONITORING_CRON_SECRET=  # header x-fad-cron-secret em POST /api/fiscal-ambiental/monitoring/scheduler/run
# FISCAL_SATELLITE_WORKER_URL=
# FISCAL_INTELLIGENCE_WORKER_URL=
# WORKER_SHARED_SECRET=  # partilhado com geo-export-worker / fiscal-satellite-worker / fiscal-intelligence-worker

# --- Geoespacial / SICAR (localizador CAR — L1+) ---
# REF_07_CAR=GO-…  # CAR fora MG para npm run geo:resolve-car-test (T18/D9)

# --- Conecta Gov — SICAR demonstrativo (L5, credencial de órgão — D7) ---
# CONECTA_GOV_SICAR_ENABLED=false
# CONECTA_GOV_SICAR_BASE_URL=https://api.conecta.gov.br
# CONECTA_GOV_CLIENT_ID=
# CONECTA_GOV_CLIENT_SECRET=

# --- MTR-MG (resíduos SEMAD/FEAM — proxy servidor P7) ---
# MTR_CHAVE_FEAM=
# MTR_API_BASE=https://mtr.meioambiente.mg.gov.br/api
# MTR_USE_HOMOLOG=true
# MTR_SYNC_CRON_SECRET=  # header x-mtr-cron-secret em POST /api/mtr/sync-batch (agendador externo)

# --- MCA v3 — worker QGIS / PDF final (local: infra/mca-qgis-worker) ---
# MCA_QGIS_WORKER_URL=http://localhost:8091
# WORKER_SHARED_SECRET=
# MCA_ENGINE_URL=http://localhost:8091

# --- Assinatura plataforma — PIX dinâmico Sicoob (ver docs/ASSINATURA-PLATAFORMA-PAGAMENTOS.md) ---
# SICOOB_MOCK_MODE=true
# SICOOB_CLIENT_ID=
# SICOOB_PIX_KEY=
# SICOOB_ENVIRONMENT=sandbox
# SICOOB_CERT_PEM=
# SICOOB_CERT_KEY=
# SICOOB_CERT_PATH=
# SICOOB_KEY_PATH=
# SICOOB_WEBHOOK_ACCESS_TOKEN=
# SICOOB_CHARGE_EXPIRATION_SECONDS=86400
# BILLING_DEBUG_SECRET=
# CRON_SECRET=
