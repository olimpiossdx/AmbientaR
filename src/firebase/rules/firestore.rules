
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Offline-first (plano): documentos editados no cliente podem usar metadados
     * opcionais (ex.: pendingSync, localRev) para reconciliação. Ao ativar por coleção,
     * alinhar validação aqui e no app — por omissão as regras atuais não dependem destes campos.
     */

    /**
     * @description Helper function to get the user's role from their profile in the 'users' collection.
     * Returns null if the user document does not exist (avoids denying access when doc is missing).
     */
    function getRole() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data.role : null;
    }

    /**
     * @description Checks if the signed-in user has the 'admin' role.
     */
    function isAdmin() {
      return request.auth != null && getRole() == 'admin';
    }
    
    /**
     * @description Checks if the user has a management role (admin, gestor, supervisor).
     */
    function isManager() {
        let role = getRole();
        return request.auth != null && (role == 'admin' || role == 'gestor' || role == 'supervisor');
    }

    /**
     * @description Cliente Gestão (titular): plano com supervisão/assessoria — sem escrita nas coleções operacionais restritas.
     */
    function isClient() {
        return request.auth != null && getRole() == 'client';
    }

    /**
     * @description Cliente Autônomo: titular que gere licenças, outorgas, condicionantes e prazos dos próprios empreendedores.
     */
    function isClienteAutonomo() {
        return request.auth != null && getRole() == 'cliente_autonomo';
    }

    /**
     * @description Autônomo só altera dados ligados a empreendedores cujo CPF/CNPJ coincide com o perfil (mesma regra de leitura).
     */
    function canClienteAutonomoManageEmpreendedor(empreendedorId) {
        return isClienteAutonomo() &&
            empreendedorId is string &&
            empreendedorId.size() > 0 &&
            canViewEmpreendedorByProfile(empreendedorId);
    }

    /**
     * @description Empreendedor vinculado a uma condicionante (via licença, outorga ou intervenção).
     */
    function condicionanteLinkedEmpreendedorIdFromData(data) {
        let refId = data.referenceId;
        let refType = data.referenceType;
        return refType == 'licenca' && refId is string && refId.size() > 0 &&
                exists(/databases/$(database)/documents/licenses/$(refId))
            ? get(/databases/$(database)/documents/licenses/$(refId)).data.empreendedorId
            : refType == 'outorga' && refId is string && refId.size() > 0 &&
                exists(/databases/$(database)/documents/outorgas/$(refId))
            ? get(/databases/$(database)/documents/outorgas/$(refId)).data.empreendedorId
            : refType == 'intervencao' && refId is string && refId.size() > 0 &&
                exists(/databases/$(database)/documents/intervencoes/$(refId))
            ? get(/databases/$(database)/documents/intervencoes/$(refId)).data.empreendedorId
            : '';
    }

    function canClienteAutonomoManageCondicionanteFromData(data) {
        let empId = condicionanteLinkedEmpreendedorIdFromData(data);
        return canClienteAutonomoManageEmpreendedor(empId);
    }

    /**
     * @description Empreendedor da outorga associada a um lançamento de monitoramento manual.
     */
    function manualMonitoringOutorgaEmpreendedorId(data) {
        return 'outorgaId' in data && data.outorgaId is string && data.outorgaId.size() > 0 &&
                exists(/databases/$(database)/documents/outorgas/$(data.outorgaId))
            ? get(/databases/$(database)/documents/outorgas/$(data.outorgaId)).data.empreendedorId
            : '';
    }

    function canWriteManualMonitoringLogData(data) {
        let empId = manualMonitoringOutorgaEmpreendedorId(data);
        return isAdmin() || isManager() || (
            empId is string && empId.size() > 0 && (
                getRole() == 'technical' || getRole() == 'diretor_fauna' ||
                (isClienteAutonomo() && canViewEmpreendedorByProfile(empId)) ||
                (getRole() == 'representative' && canRepresentativeAccessEmpreendedor(empId))
            )
        );
    }

    /**
     * @description Excluir projeto: equipe interna (exceto perfis de portal/representante) ou autônomo só nos seus empreendedores.
     * Cliente Gestão não exclui projetos (gestão pela consultoria).
     */
    function canDeleteProject() {
        let role = getRole();
        return isSignedIn() && (
            isAdmin() || isManager() || (
                role != 'client' &&
                role != 'representative' &&
                role != 'cliente_autonomo'
            ) || (
                isClienteAutonomo() &&
                'empreendedorId' in resource.data &&
                resource.data.empreendedorId is string &&
                canViewEmpreendedorByProfile(resource.data.empreendedorId)
            )
        );
    }

    /**
     * @description Helper function to get the current user's profile data.
     * Returns null if the document does not exist (avoids throwing).
     */
    function getUserProfile(userId) {
      let path = /databases/$(database)/documents/users/$(userId);
      return exists(path) ? get(path).data : null;
    }
    
    /**
     * @description Checks if the user is authorized to see a specific license.
     * Clients can only see licenses linked to their empreendedores.
     */
    function canViewLicense(license) {
      let userProfile = getUserProfile(request.auth.uid);
      return userProfile != null && (
        (userProfile.cpf != null && userProfile.cpf == get(/databases/$(database)/documents/empreendedores/$(license.empreendedorId)).data.cpfCnpj) ||
        (userProfile.cnpjs != null && get(/databases/$(database)/documents/empreendedores/$(license.empreendedorId)).data.cpfCnpj in userProfile.cnpjs)
      );
    }
    
    /**
     * @description Titular (cliente): CPF/CNPJ do perfil bate com o empreendedor.
     */
    function canViewEmpreendedorByProfile(empreendedorId) {
      let empPath = /databases/$(database)/documents/empreendedores/$(empreendedorId);
      let userProfile = getUserProfile(request.auth.uid);
      return exists(empPath) && userProfile != null && (
        (userProfile.cpf != null && userProfile.cpf == get(empPath).data.cpfCnpj) ||
        (userProfile.cnpjs != null && get(empPath).data.cpfCnpj in userProfile.cnpjs)
      );
    }

    /**
     * @description Representante aprovado no cadastro do empreendedor (approvedUserIds).
     */
    function canRepresentativeAccessEmpreendedor(empreendedorId) {
      let empPath = /databases/$(database)/documents/empreendedores/$(empreendedorId);
      return getRole() == 'representative' &&
        exists(empPath) &&
        'approvedUserIds' in get(empPath).data &&
        request.auth.uid in get(empPath).data.approvedUserIds;
    }

    function canAccessEmpreendedorTelemetry(empreendedorId) {
      return canViewEmpreendedorByProfile(empreendedorId) ||
        canRepresentativeAccessEmpreendedor(empreendedorId);
    }

     /**
     * @description Checks if the user is authorized to see a specific water permit (outorga).
     */
    function canViewOutorga(outorga) {
      return canViewEmpreendedorByProfile(outorga.empreendedorId);
    }

    /**
     * @description Telemetria: outorga OU uso insignificante; titular ou representante aprovado.
     */
    function canAccessTelemetryReadingData(data) {
      return (
        ('outorgaId' in data && data.outorgaId is string && data.outorgaId.size() > 0 &&
          exists(/databases/$(database)/documents/outorgas/$(data.outorgaId)) &&
          canAccessEmpreendedorTelemetry(
            get(/databases/$(database)/documents/outorgas/$(data.outorgaId)).data.empreendedorId)
        ) ||
        ('usoInsignificanteId' in data && data.usoInsignificanteId is string && data.usoInsignificanteId.size() > 0 &&
          exists(/databases/$(database)/documents/usosInsignificantes/$(data.usoInsignificanteId)) &&
          canAccessEmpreendedorTelemetry(
            get(/databases/$(database)/documents/usosInsignificantes/$(data.usoInsignificanteId)).data.empreendedorId)
        )
      );
    }

    function canReadTelemetryRole() {
      let role = getRole();
      return isAdmin() || isManager() ||
        role == 'technical' || role == 'diretor_fauna' ||
        role == 'sales' || role == 'financial' || role == 'advogado';
    }

    /**
     * @description Checks if the signed-in user has the 'financial' role.
     */
    function isFinancial() {
      return request.auth != null && getRole() == 'financial';
    }

     /**
     * @description Checks if the signed-in user has the 'sales' role.
     */
    function isSales() {
        return request.auth != null && getRole() == 'sales';
    }

    /**
     * @description Checks if the signed-in user has the 'supervisor' role.
     */
    function isSupervisor() {
      return request.auth != null && getRole() == 'supervisor';
    }

    /**
     * @description Checks if the user is signed in.
     */
    function isSignedIn() {
      return request.auth != null;
    }
    
    /**
     * @description Checks if the user is authorized to perform technical inspections.
     * Denies access to financial, client, sales and representative roles.
     */
    function isAuthorizedInspector() {
      let role = getRole();
      return isSignedIn() && role != 'financial' && role != 'client' && role != 'cliente_autonomo' && role != 'sales' && role != 'representative';
    }
    
    /**
     * @description Audit logs can be created by any signed-in user.
     * Admins or supervisors can read any log.
     * @path /databases/{database}/documents/auditLogs/{logId}
     */
    match /auditLogs/{logId} {
      allow read: if isAdmin() || isSupervisor();
      allow write: if isSignedIn();
    }
    
     /**
     * @description Defines access rules for 'oficios' collection.
     * Admins and managers can read all. Clients can read ofícios addressed to them.
     * Creating is for signed-in users. Updating/deleting drafts by creator. Admins can delete completed.
     * @path /databases/{database}/documents/oficios/{oficioId}
     */
    match /oficios/{oficioId} {
        // Leitura de um documento específico
        allow get: if isSignedIn()
          && (
            isAdmin()
            || isSupervisor()
            || resource.data.createdBy == request.auth.uid
            || (
              getUserProfile(request.auth.uid) != null
              && resource.data.recipient == getUserProfile(request.auth.uid).get('name', '')
            )
          );

        // Listagem/consultas: qualquer usuário autenticado pode listar,
        // o front já filtra por recipient para clientes.
        allow list: if isSignedIn();

        allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
        allow update: if (isSignedIn() && resource.data.createdBy == request.auth.uid && resource.data.status == 'Rascunho') || isAdmin();
        allow delete: if (isSignedIn() && resource.data.createdBy == request.auth.uid && resource.data.status == 'Rascunho') || isAdmin();
    }
    
    /**
     * @description Defines access rules for 'oficioCounters'.
     * Only authenticated users can read/write to allow for transactional increments.
     * @path /databases/{database}/documents/oficioCounters/{year}
     */
    match /oficioCounters/{year} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Allows users to manage their own profile and notifications. Admins and Supervisors can manage any user.
     * Any authenticated user can list users (for chat functionality).
     */
    /**
     * @description Campos de assinatura anual da plataforma — só admin/supervisor ou criação inicial do próprio usuário.
     * Nota: allowsCommercialContact (marketing) não está aqui; o próprio utilizador pode atualizar no perfil, salvo restrições futuras da app.
     */
    function userSubscriptionFieldKeys() {
      return [
        'platformPaymentStatus',
        'platformAccessValidUntil',
        'platformPaymentMethod',
        'platformPaymentVerifiedAt',
      ];
    }

    function selfUserUpdateTouchesSubscription() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(userSubscriptionFieldKeys());
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && (
        request.auth.uid == userId ||
        isAdmin() ||
        isSupervisor()
      );
      allow update: if isAdmin() || isSupervisor() || (
        request.auth.uid == userId && !selfUserUpdateTouchesSubscription()
      );
      allow delete: if isAdmin() || isSupervisor() || request.auth.uid == userId;

      /**
       * @description A user can read their own notifications. Admins can read any notifications.
       */
      match /notifications/{notificationId} {
        allow read, write: if request.auth.uid == userId || isAdmin();
      }
    }
    
    /**
     * @description Rules for chat functionality.
     * A user can read/create/update chat documents and messages only if they are a participant.
     */
    match /chats/{chatId} {
      allow get, update: if isSignedIn() && request.auth.uid in resource.data.participants;
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow update: if isSignedIn()
                      && request.resource.data.keys().hasOnly(['deletedFor'])
                      && request.resource.data.deletedFor.hasAny([request.auth.uid]);
        allow delete: if false; 
      }
    }
    
    /**
     * @description Allows any authenticated user to manage commercial client data.
     * Read: any signed-in user (so client-role can read linked client doc without needing getRole()).
     * @path /databases/{database}/documents/clients/{clientId}
     */
    match /clients/{clientId} {
      allow read: if request.auth != null;
      allow write: if isSignedIn();
    }
    
    /**
     * @description Allows any authenticated user to manage supplier data.
     * @path /databases/{database}/documents/fornecedores/{fornecedorId}
     */
    match /fornecedores/{fornecedorId} {
      allow read: if isAdmin() || isFinancial() || isSupervisor();
      allow write: if isAdmin() || isFinancial() || isSupervisor();
    }
    
    /**
     * @description Rules for the service catalog.
     * Read access for all authenticated users.
     * Write access restricted to Admin, Financial, and Supervisor roles.
     */
    match /services/{serviceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinancial() || isSupervisor();
    }


    /**
     * @description Allows any authenticated user to manage technical empreendedor data.
     * @path /databases/{database}/documents/empreendedores/{empreendedorId}
     */
    match /empreendedores/{empreendedorId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage fauna studies.
     * @path /databases/{database}/documents/faunaStudies/{studyId}
     */
    match /faunaStudies/{studyId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage inventory projects.
     * @path /databases/{database}/documents/inventories/{inventoryId}
     */
    match /inventories/{inventoryId} {
      allow read, write: if isSignedIn();
      match /calculationRuns/{runId} {
        allow read, write: if isSignedIn();
      }
    }

    /**
     * Fotos do inventário florestal (URLs no Storage + metadados). Substitui armazenamento em disco local.
     * @path /inventoryProjectPhotos/{projectId}
     */
    match /inventoryProjectPhotos/{projectId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage socio-environmental analyses.
     * Esses documentos são usados para estudos e formulários; controle fino é feito no front.
     * @path /databases/{database}/documents/analisesSocioambientais/{analysisId}
     */
    match /analisesSocioambientais/{analysisId} {
      allow read, write: if isSignedIn();
    }
    
     /**
     * @description Allows public read on company settings for branding, but write access is restricted to admin.
     * @path /databases/{database}/documents/companySettings/{settingId}
     */
    match /companySettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    /**
     * @description Allows any authenticated user to manage environmental companies.
     * @path /databases/{database}/documents/environmentalCompanies/{companyId}
     */
    match /environmentalCompanies/{companyId} {
        allow read, write: if isSignedIn();
    }
    
    /**
     * @description Allows any authenticated user to manage technical responsible people.
     * @path /databases/{database}/documents/technicalResponsibles/{responsibleId}
     */
    match /technicalResponsibles/{responsibleId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Projects — leitura ampla; escrita geral exceto campo `car` para cliente/representante
     * (CAR só é gerido por perfis internos; titular/representante consultam na UI).
     * @path /databases/{database}/documents/projects/{projectId}
     */
    match /projects/{projectId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        !(getRole() == 'client' || getRole() == 'cliente_autonomo' || getRole() == 'representative') ||
        !('car' in request.resource.data)
      );
      allow update: if isSignedIn() && (
        !(getRole() == 'client' || getRole() == 'cliente_autonomo' || getRole() == 'representative') ||
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['car'])
      );
      allow delete: if canDeleteProject();
    }

    /**
     * @description Defines access rules for the 'licenses' collection.
     * Managers (admin, gestor, supervisor) have full write access.
     * Clients can list (app filtra por empreendedor do titular).
     */
    match /licenses/{licenseId} {
      allow read: if request.auth != null;
      allow create: if isManager() || isAdmin() ||
        canClienteAutonomoManageEmpreendedor(request.resource.data.empreendedorId);
      allow update, delete: if isManager() || isAdmin() ||
        canClienteAutonomoManageEmpreendedor(resource.data.empreendedorId);
    }

    /**
     * @description Allows any authenticated user to manage new process requests.
     * @path /databases/{database}/documents/requests/{requestId}
     */
    match /requests/{requestId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Processo interno de defesa de auto de infração.
     * Restrito ao perfil administrador.
     * @path /databases/{database}/documents/autoInfracaoDefesas/{defesaId}
     */
    match /autoInfracaoDefesas/{defesaId} {
      allow read, write: if isAdmin();
    }
    
    /**
     * @description Managers can write and list all. Clients can list (app filtra por empreendedor do titular).
     */
    match /outorgas/{outorgaId} {
      allow read: if request.auth != null;
      allow create: if isManager() || isAdmin() ||
        canClienteAutonomoManageEmpreendedor(request.resource.data.empreendedorId);
      allow update, delete: if isManager() || isAdmin() ||
        canClienteAutonomoManageEmpreendedor(resource.data.empreendedorId);
    }

    /**
     * @description Usos insignificantes de água — mesmo perfil de acesso que outorgas.
     * @path /databases/{database}/documents/usosInsignificantes/{id}
     */
    match /usosInsignificantes/{usoId} {
      allow read: if request.auth != null;
      allow create: if isManager() || isAdmin() ||
        canClienteAutonomoManageEmpreendedor(request.resource.data.empreendedorId);
      allow update, delete: if isManager() || isAdmin() ||
        canClienteAutonomoManageEmpreendedor(resource.data.empreendedorId);
    }
    
    /**
     * @description Allows any authenticated user to manage manual monitoring logs.
     * @path /databases/{database}/documents/manualMonitoringLogs/{logId}
     */
    match /manualMonitoringLogs/{logId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && canWriteManualMonitoringLogData(request.resource.data);
      allow delete: if isSignedIn() && canWriteManualMonitoringLogData(resource.data);
    }

    /**
     * @description Leituras telemétricas — leitura restrita à outorga visível ao cliente; gestão por admin/gestor.
     * @path /databases/{database}/documents/telemetryReadings/{readingId}
     */
    match /telemetryReadings/{readingId} {
      allow read: if isSignedIn() && (
        canReadTelemetryRole() ||
        ((getRole() == 'client' || getRole() == 'cliente_autonomo' || getRole() == 'representative') &&
          canAccessTelemetryReadingData(resource.data))
      );
      allow create: if isSignedIn() && request.resource.data.keys().hasAll(['pontoId', 'timestamp', 'pumpOn']) &&
        (
          (request.resource.data.outorgaId is string && request.resource.data.outorgaId.size() > 0) ||
          (request.resource.data.usoInsignificanteId is string && request.resource.data.usoInsignificanteId.size() > 0)
        ) &&
        (
          isAdmin() || isManager() ||
          (getRole() == 'cliente_autonomo' && canAccessTelemetryReadingData(request.resource.data)) ||
          (getRole() == 'representative' && canAccessTelemetryReadingData(request.resource.data))
        );
      allow update: if isAdmin() || isManager() ||
        (isClienteAutonomo() && canAccessTelemetryReadingData(resource.data));
      allow delete: if isAdmin() || isManager() ||
        (isClienteAutonomo() && canAccessTelemetryReadingData(resource.data));
    }

    /**
     * @description Managers can write. Any signed-in user can read/list (app filtra por empreendedor do titular).
     * @path /databases/{database}/documents/intervencoes/{intervencaoId}
     */
    match /intervencoes/{intervencaoId} {
        allow read: if request.auth != null;
        allow create: if isManager() || isAdmin() ||
          canClienteAutonomoManageEmpreendedor(request.resource.data.empreendedorId);
        allow update, delete: if isManager() || isAdmin() ||
          canClienteAutonomoManageEmpreendedor(resource.data.empreendedorId);
    }

    /**
     * @description Allows any authenticated user to manage inspections.
     * @path /databases/{database}/documents/inspections/{inspectionId}
     */
    match /inspections/{inspectionId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Allows managers to write and list all conditions. Other signed-in users can only read specific ones.
     * @path /databases/{database}/documents/condicionantes/{condicionanteId}
     */
    match /condicionantes/{condicionanteId} {
        allow get: if isSignedIn();
        allow list: if isSignedIn();
        allow create: if isManager() ||
          canClienteAutonomoManageCondicionanteFromData(request.resource.data);
        allow update, delete: if isManager() ||
          canClienteAutonomoManageCondicionanteFromData(request.resource.data);
    }

    /**
     * @description Allows any authenticated user to manage PRADA forms.
     * @path /databases/{database}/documents/pradas/{pradaId}
     */
    match /pradas/{pradaId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage PTRF forms.
     * @path /databases/{database}/documents/ptrfs/{ptrfId}
     */
    match /ptrfs/{ptrfId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage RCA forms.
     * @path /databases/{database}/documents/rcas/{rcaId}
     */
    match /rcas/{rcaId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage PCA forms.
     * @path /databases/{database}/documents/pcas/{pcaId}
     */
    match /pcas/{pcaId} {
      allow read, write: if isSignedIn();
    }
    
    /**
     * @description Allows any authenticated user to manage PIA forms.
     * @path /databases/{database}/documents/pias/{piaId}
     */
    match /pias/{piaId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage EIA/RIMA forms.
     * @path /databases/{database}/documents/eiaRimas/{eiaRimaId}
     */
    match /eiaRimas/{eiaRimaId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Allows financial team and admins to manage invoices. Others can read.
     * @path /databases/{database}/documents/invoices/{invoiceId}
     */
    match /invoices/{invoiceId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinancial() || isSupervisor();
    }

     /**
     * @description Allows sales team and admins to manage proposals. Others can read.
     * @path /databases/{database}/documents/commercialProposals/{proposalId}
     */
    match /commercialProposals/{proposalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSales() || isSupervisor() || isFinancial();
      allow update: if (isAdmin() || isFinancial()) || (
        (isSales() || isSupervisor()) &&
        !(
          'status' in request.resource.data &&
          (
            request.resource.data.status == 'Accepted' ||
            request.resource.data.status == 'Rejected'
          ) &&
          resource.data.status != request.resource.data.status
        )
      );
    }

    /**
     * @description Orçamentos (coleção `proposals`). Evita depender só do catch-all admin.
     * @path /databases/{database}/documents/proposals/{proposalId}
     */
    match /proposals/{proposalId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSales() || isSupervisor() || isFinancial();
    }

    /**
     * @description Allows sales team and admins to manage contracts. Others can read.
     * @path /databases/{database}/documents/contracts/{contractId}
     */
    match /contracts/{contractId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSales() || isSupervisor() || isFinancial();
      allow update: if (isAdmin() || isFinancial()) || (
        (isSales() || isSupervisor()) &&
        !(
          'status' in request.resource.data &&
          request.resource.data.status == 'Aprovado' &&
          resource.data.status != 'Aprovado'
        )
      );
    }

    /**
     * @description Contratos de prestação entre empresa e fornecedores.
     * @path /databases/{database}/documents/supplierContracts/{contractId}
     */
    match /supplierContracts/{contractId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSales() || isSupervisor() || isFinancial();
    }

    /**
     * @description Defines access rules for appointments. Admins/Supervisors/Financial see all.
     * Others see non-financial events or their own. Anyone can create/write.
     * @path /databases/{database}/documents/appointments/{appointmentId}
     */
    match /appointments/{appointmentId} {
        allow get: if isSignedIn() && (
            isAdmin() ||
            isSupervisor() ||
            isFinancial() ||
            resource.data.ownerRole != 'financial' || // Public event
            resource.data.ownerId == request.auth.uid  // Own event
        );
        allow list: if isSignedIn();
        allow write: if isSignedIn();
    }

    /**
     * @description Allows any authenticated user to manage sustainability reports.
     * @path /databases/{database}/documents/sustainabilityReports/{reportId}
     */
    match /sustainabilityReports/{reportId} {
      allow read, write: if isSignedIn();
    }

    /**
     * @description Allows read access to signed-in users. Write access is restricted to admin or financial roles.
     * @path /databases/{database}/documents/revenues/{revenueId}
     */
    match /revenues/{revenueId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinancial();
    }

    /**
     * @description Allows read access to signed-in users. Write access is restricted to admin or financial roles.
     * @path /databases/{database}/documents/expenses/{expenseId}
     */
    match /expenses/{expenseId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isFinancial();
    }

    /**
     * @description Allows read access to signed-in users. Write access is restricted to admin or sales roles.
     * @path /databases/{database}/documents/opportunities/{opportunityId}
     */
    match /opportunities/{opportunityId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSales() || isSupervisor();
    }

    /**
     * @description Allows read access to signed-in users. Write access is restricted to admin or sales roles.
     * @path /databases/{database}/documents/contacts/{contactId}
     */
    match /contacts/{contactId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isSales() || isSupervisor();
    }
    
    match /charcoalReports/{reportId} {
        allow read, write: if isSignedIn();
    }
    
    match /transporteResiduosReports/{reportId} {
        allow read, write: if isSignedIn();
    }
    
    match /dispensaPea/{dispensaId} {
        allow read, write: if isSignedIn();
    }

    /**
     * @description Pagamento anual da plataforma (cadastro titular): o próprio usuário cria o pedido;
     * leitura do próprio ou admin; atualização só admin (confirmação).
     * @path /databases/{database}/documents/platform_payment_requests/{requestId}
     */
    match /platform_payment_requests/{requestId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId', 'email', 'name', 'packageId', 'method', 'amountLabel', 'status', 'createdAt']);
      allow read: if isSignedIn() && (
        isAdmin() || isSupervisor() ||
        resource.data.userId == request.auth.uid
      );
      allow update, delete: if isAdmin() || isSupervisor();
    }

    /**
     * @description Pedidos de acesso: qualquer usuário autenticado pode listar/criar/atualizar (app filtra por titular).
     * Usa request.auth != null para não depender de getRole() e evitar negação quando o doc do usuário não existe.
     */
    match /access_requests/{requestId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null;
    }

    /**
     * @description Hub IA (RAG): somente admins podem ler/escrever.
     * @path /databases/{database}/documents/ai_lab_sources/{sourceId}
     */
    match /ai_lab_sources/{sourceId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Hub IA (histórico): somente admins podem ler/escrever.
     * @path /databases/{database}/documents/ai_lab_reports/{reportId}
     */
    match /ai_lab_reports/{reportId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Hub IA (controle de custo): somente admins podem ler/escrever.
     * @path /databases/{database}/documents/ai_lab_cost_controls/{docId}
     */
    match /ai_lab_cost_controls/{docId} {
      allow read, write: if isAdmin();
    }

    /**
     * @description Backups de exclusão para trilha de segurança.
     * Somente admin/supervisor podem consultar e gravar.
     * @path /databases/{database}/documents/deleted_data_backups/{backupId}
     */
    match /deleted_data_backups/{backupId} {
      allow read, write: if isAdmin() || isSupervisor();
    }

    /**
     * @description Admin com acesso total em qualquer coleção/documento.
     * Mantido no final para garantir visão global administrativa.
     */
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
