{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npx next dev -p 9002 --hostname 0.0.0.0",
    "dev:turbo": "npx next dev -p 9002 --hostname 0.0.0.0 --turbo",
    "dev:tunnel": "npx --yes localtunnel --port 9002",
    "dev:tunnel:cf": "cloudflared tunnel --url http://localhost:9002",
    "mcp:firebase:http": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/start-firebase-mcp-http.ps1",
    "genkit:dev": "genkit start -- tsx src/ai/dev.ts",
    "genkit:watch": "genkit start -- tsx --watch src/ai/dev.ts",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:uploads": "node scripts/check-upload-patterns.cjs",
    "deploy:rules": "npx firebase deploy --only firestore:rules",
    "cap:sync": "npx cap sync",
    "cap:sync:deploy": "node scripts/cap-sync-deploy.cjs",
    "cap:open:android": "npx cap open android",
    "cap:open:ios": "npx cap open ios",
    "cap:copy": "npx cap copy",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
