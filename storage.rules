
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function userRoleForStorage() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    /** PDF e geometria do CAR: leitura para autenticados; escrita só para perfis que gerem CAR. */
    function mayWriteCarStorage() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        userRoleForStorage() != 'client' &&
        userRoleForStorage() != 'cliente_autonomo' &&
        userRoleForStorage() != 'representative';
    }

    /** Uploads financeiros: apenas admin e financeiro. */
    function mayWriteFinancialStorage() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
        (userRoleForStorage() == 'admin' || userRoleForStorage() == 'financial');
    }

    match /car/{fileName} {
      allow read: if request.auth != null;
      allow write: if mayWriteCarStorage();
    }

    match /car-shp/{fileName} {
      allow read: if request.auth != null;
      allow write: if mayWriteCarStorage();
    }

    // Permite leitura pública de imagens de branding.
    // A escrita é permitida apenas para o dono do diretório (usuário autenticado).
    match /branding/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Pastas financeiras / contratos: leitura autenticada; escrita admin/financeiro.
    match /invoices/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if mayWriteFinancialStorage();
    }
    match /contracts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if mayWriteFinancialStorage();
    }
    match /receipts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if mayWriteFinancialStorage();
    }
    match /signed-contracts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if mayWriteFinancialStorage();
    }
    match /transactions/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if mayWriteFinancialStorage();
    }
    match /commercial-proposals/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if mayWriteFinancialStorage();
    }
    match /supplier-contracts/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if mayWriteFinancialStorage();
    }
    
    // Regra padrão: nega acesso a todos os outros caminhos por segurança,
    // exceto para usuários autenticados (regra geral).
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
